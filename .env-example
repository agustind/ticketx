APP_NAME=Masonite
APP_DEBUG=True
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000
MIX_BASE_URL=

DB_CONNECTION=sqlite
SQLITE_DB_DATABASE=database.sqlite3
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masonite
DB_USERNAME=root
DB_PASSWORD=
DB_LOG=True
# Postgres connection URL; when set it overrides DB_HOST/DB_PORT/etc. (Railway sets it from the database)
DATABASE_URL=

MAIL_DRIVER=terminal
MAIL_FROM=no-reply@masonite.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_REGION=us

QUEUE_DRIVER=async

S3_CLIENT=
S3_SECRET=
S3_BUCKET=

SLACK_TOKEN=
SLACK_WEBHOOK=

VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

PUSHER_CLIENT=
PUSHER_APP_ID=
PUSHER_SECRET=
PUSHER_CLUSTER=

# JWT_SECRET=

# Ticket marketplace
# Claude reads uploaded ticket PDFs. Without it, uploads return 503.
ANTHROPIC_API_KEY=
# TICKET_READER_MODEL=claude-opus-5-5
# Private bucket for ticket PDFs. Leave unset locally to store them in storage/private/tickets.
TICKETS_BUCKET=
TICKETS_BUCKET_ENDPOINT=
TICKETS_BUCKET_REGION=auto
TICKETS_BUCKET_ACCESS_KEY_ID=
TICKETS_BUCKET_SECRET_ACCESS_KEY=
